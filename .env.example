# Supabase (client-side, brukt av frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-side, brukt av api/-funksjoner)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Teacher access (simple password, no real auth)
VITE_TEACHER_PASSWORD=changeme

# Anthropic (server-side only — never expose in VITE_ prefix)
ANTHROPIC_API_KEY=sk-ant-...

# Resend email (server-side only, ingen SMS i dette prosjektet)
RESEND_API_KEY=re_xxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_REPLY_TO=abel@yourdomain.com

# Cron-jobb (api/send-scheduled-reminders.js, api/send-teacher-digest.js),
# beskytter endepunktene mot uautoriserte kall. Vercel sender denne
# automatisk som Bearer-header når du setter samme verdi som
# miljøvariabel i Vercel-prosjektet.
CRON_SECRET=generer-en-tilfeldig-streng-selv

# Eneste mottaker av de automatiske statusoppdateringene til faglærer
# (api/send-teacher-digest.js). Faller tilbake til EMAIL_REPLY_TO hvis
# denne ikke er satt.
TEACHER_EMAIL=abel@yourdomain.com
